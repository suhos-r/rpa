<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_RunScenario" mva:VisualBasic.Settings="{x:Null}"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Scenario" Type="InArgument(sd:DataRow)" />
    <x:Property Name="in_RunId" Type="InArgument(x:String)" />
    <x:Property Name="in_BasePortalUrl" Type="InArgument(x:String)" />
    <x:Property Name="io_Results" Type="InOutArgument(sd:DataTable)" />
  </x:Members>
  <Sequence DisplayName="Run isolated scenario">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="scenarioId" />
      <Variable x:TypeArguments="x:String" Name="scenarioName" />
      <Variable x:TypeArguments="x:String" Name="faultMode" />
      <Variable x:TypeArguments="x:String" Name="expectedBehavior" />
      <Variable x:TypeArguments="x:String" Name="employeeId" />
      <Variable x:TypeArguments="x:String" Name="employeeName" />
      <Variable x:TypeArguments="x:String" Name="department" />
      <Variable x:TypeArguments="x:String" Name="notes" />
      <Variable x:TypeArguments="x:String" Name="targetUrl" />
      <Variable x:TypeArguments="x:String" Name="evidencePath" />
      <Variable x:TypeArguments="x:String" Name="actualBehavior" />
      <Variable x:TypeArguments="x:String" Name="verdict" />
      <Variable x:TypeArguments="x:String" Name="dataIntegrity" />
      <Variable x:TypeArguments="x:String" Name="exceptionType" />
      <Variable x:TypeArguments="x:String" Name="exceptionMessage" />
      <Variable x:TypeArguments="x:String" Name="statusText" />
      <Variable x:TypeArguments="x:Boolean" Name="visibleSuccess" />
      <Variable x:TypeArguments="x:Int32" Name="recordsBefore" />
      <Variable x:TypeArguments="x:Int32" Name="recordsAfter" />
      <Variable x:TypeArguments="x:Int64" Name="startTicks" />
      <Variable x:TypeArguments="x:String" Name="durationMs" />
    </Sequence.Variables>
    <Assign x:TypeArguments="x:String" DisplayName="Read scenario id"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="scenarioId" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;scenario_id&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read scenario name"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="scenarioName" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;scenario_name&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read fault mode"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="faultMode" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;fault_mode&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read expected behavior"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="expectedBehavior" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;expected_behavior&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read employee id"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="employeeId" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;employee_id&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read employee name"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="employeeName" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;employee_name&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read department"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="department" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;department&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Read notes"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="notes" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Scenario(&quot;notes&quot;).ToString.Trim" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Build target URL"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="targetUrl" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_BasePortalUrl &amp; &quot;?fault=&quot; &amp; faultMode &amp; &quot;&amp;reset=1&amp;scenario=&quot; &amp; scenarioId" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Build evidence path"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="evidencePath" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Evidence&quot;, in_RunId &amp; &quot;_&quot; &amp; scenarioId &amp; &quot;_&quot; &amp; If(faultMode = &quot;none&quot;, &quot;SUCCESS&quot;, If(faultMode = &quot;post_commit_error&quot;, &quot;UNSAFE_FAIL&quot;, If(faultMode = &quot;missing_button&quot;, &quot;SAFE_FAIL&quot;, &quot;RECOVERED_SUCCESS&quot;))) &amp; &quot;.png&quot;)" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:Int32" DisplayName="Set records before"><Assign.To><OutArgument x:TypeArguments="x:Int32"><VisualBasicReference x:TypeArguments="x:Int32" ExpressionText="recordsBefore" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32"><VisualBasicValue x:TypeArguments="x:Int32" ExpressionText="0" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:Int64" DisplayName="Start timer"><Assign.To><OutArgument x:TypeArguments="x:Int64"><VisualBasicReference x:TypeArguments="x:Int64" ExpressionText="startTicks" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int64"><VisualBasicValue x:TypeArguments="x:Int64" ExpressionText="System.DateTime.UtcNow.Ticks" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:Boolean" DisplayName="Initialize visible success"><Assign.To><OutArgument x:TypeArguments="x:Boolean"><VisualBasicReference x:TypeArguments="x:Boolean" ExpressionText="visibleSuccess" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean"><VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="False" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:Int32" DisplayName="Initialize records after"><Assign.To><OutArgument x:TypeArguments="x:Int32"><VisualBasicReference x:TypeArguments="x:Int32" ExpressionText="recordsAfter" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32"><VisualBasicValue x:TypeArguments="x:Int32" ExpressionText="0" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Initialize exception type"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="exceptionType" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;&quot;" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Initialize exception message"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="exceptionMessage" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;&quot;" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Initialize status"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="statusText" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;&quot;" /></InArgument></Assign.Value></Assign>
    <TryCatch DisplayName="Isolate scenario execution">
      <TryCatch.Try>
        <Sequence DisplayName="Try scenario">
          <ui:InvokeWorkflowFile DisplayName="Process employee" WorkflowFileName="Workflows\ProcessEmployee.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <scg:Dictionary x:TypeArguments="x:String, Argument">
                <InArgument x:TypeArguments="x:String" x:Key="in_TargetUrl">[targetUrl]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeId">[employeeId]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeName">[employeeName]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_Department">[department]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_FaultMode">[faultMode]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_EvidencePath">[evidencePath]</InArgument>
                <OutArgument x:TypeArguments="x:Boolean" x:Key="out_VisibleSuccess">[visibleSuccess]</OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="out_StatusText">[statusText]</OutArgument>
                <OutArgument x:TypeArguments="x:Int32" x:Key="out_RecordCount">[recordsAfter]</OutArgument>
              </scg:Dictionary>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument>
            <Sequence DisplayName="Catch scenario exception">
              <Assign x:TypeArguments="x:String" DisplayName="Capture exception type"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="exceptionType" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="exception.GetType().Name" /></InArgument></Assign.Value></Assign>
              <Assign x:TypeArguments="x:String" DisplayName="Capture exception message"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="exceptionMessage" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="exception.Message" /></InArgument></Assign.Value></Assign>
              <ui:LogMessage Level="Warn" DisplayName="Log scenario exception"><ui:LogMessage.Message><InArgument x:TypeArguments="x:Object"><VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;[AUTOCHAOS] &quot; &amp; scenarioId &amp; &quot; exception: &quot; &amp; exceptionMessage" /></InArgument></ui:LogMessage.Message></ui:LogMessage>
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    <Assign x:TypeArguments="x:String" DisplayName="Calculate duration"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="durationMs" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="CStr((System.DateTime.UtcNow.Ticks - startTicks) \ 10000)" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Default classification"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="actualBehavior" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;UNSAFE_FAIL&quot;" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Default verdict"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="verdict" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;FAIL&quot;" /></InArgument></Assign.Value></Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Default integrity"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="dataIntegrity" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;FAIL&quot;" /></InArgument></Assign.Value></Assign>
    <If DisplayName="Classify successful transaction">
      <If.Condition><InArgument x:TypeArguments="x:Boolean"><VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="visibleSuccess AndAlso recordsAfter = recordsBefore + 1 AndAlso exceptionType = &quot;&quot;" /></InArgument></If.Condition>
      <If.Then>
        <Sequence DisplayName="Success classification">
          <Assign x:TypeArguments="x:String" DisplayName="Set actual success"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="actualBehavior" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="If(faultMode = &quot;none&quot;, &quot;SUCCESS&quot;, &quot;RECOVERED_SUCCESS&quot;)" /></InArgument></Assign.Value></Assign>
          <Assign x:TypeArguments="x:String" DisplayName="Set success verdict"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="verdict" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;PASS&quot;" /></InArgument></Assign.Value></Assign>
          <Assign x:TypeArguments="x:String" DisplayName="Set success integrity"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="dataIntegrity" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;PASS&quot;" /></InArgument></Assign.Value></Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Check safe failure">
          <If DisplayName="Classify safe failure">
            <If.Condition><InArgument x:TypeArguments="x:Boolean"><VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="expectedBehavior = &quot;SAFE_FAIL&quot; AndAlso Not visibleSuccess AndAlso recordsAfter = recordsBefore AndAlso (exceptionType &lt;&gt; &quot;&quot; OrElse statusText &lt;&gt; &quot;&quot;)" /></InArgument></If.Condition>
            <If.Then>
              <Sequence DisplayName="Safe failure classification">
                <Assign x:TypeArguments="x:String" DisplayName="Set safe failure"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="actualBehavior" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;SAFE_FAIL&quot;" /></InArgument></Assign.Value></Assign>
                <Assign x:TypeArguments="x:String" DisplayName="Set safe failure verdict"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="verdict" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;PASS&quot;" /></InArgument></Assign.Value></Assign>
                <Assign x:TypeArguments="x:String" DisplayName="Set safe failure integrity"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="dataIntegrity" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;PASS&quot;" /></InArgument></Assign.Value></Assign>
              </Sequence>
            </If.Then>
            <If.Else><Sequence DisplayName="Unsafe failure classification" /></If.Else>
          </If>
        </Sequence>
      </If.Else>
    </If>
    <ui:AddDataRow DisplayName="Append scenario result" ArrayRow="[New Object(){in_RunId, scenarioId, scenarioName, faultMode, expectedBehavior, actualBehavior, verdict, recordsBefore.ToString, recordsAfter.ToString, dataIntegrity, durationMs, exceptionType, exceptionMessage, evidencePath, notes}]" DataTable="[io_Results]" />
    <ui:AppendWriteCsvFile DisplayName="Write live results" FilePath="[System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Data&quot;, &quot;Output&quot;, &quot;results.csv&quot;)]" CsvAction="Write" AddHeaders="True"><ui:AppendWriteCsvFile.DataTable><InArgument x:TypeArguments="sd:DataTable"><VisualBasicValue x:TypeArguments="sd:DataTable" ExpressionText="io_Results" /></InArgument></ui:AppendWriteCsvFile.DataTable></ui:AppendWriteCsvFile>
    <ui:LogMessage Level="Info" DisplayName="Log scenario result"><ui:LogMessage.Message><InArgument x:TypeArguments="x:Object"><VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;[AUTOCHAOS] &quot; &amp; scenarioId &amp; &quot; =&gt; &quot; &amp; actualBehavior &amp; &quot; / &quot; &amp; verdict" /></InArgument></ui:LogMessage.Message></ui:LogMessage>
  </Sequence>
</Activity>
